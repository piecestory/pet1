// ==========================================================
// قاعدة بيانات موقع "قطعة وقصة" - المرحلة الأولى (MVP)
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------- الصلاحيات ----------------
enum Role {
  SUPER_ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

// ---------------- المستخدمون ----------------
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  passwordHash  String
  role          Role     @default(CUSTOMER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  addresses               Address[]
  orders                  Order[]
  cartItems               CartItem[]
  wishlistItems           WishlistItem[]
  personalShopperRequests PersonalShopperRequest[]
  auctionInterests        AuctionInterest[]
  notifications           Notification[]

  @@map("users")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  country   String
  city      String
  district  String?
  street    String?
  postal    String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

// ---------------- التصنيفات ----------------
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  image       String?
  parentId    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@map("categories")
}

// ---------------- المنتجات ----------------
model Product {
  id              String   @id @default(cuid())
  sku             String   @unique
  title           String
  slug            String   @unique
  shortDesc       String?  @db.Text
  description     String?  @db.Text
  story           String?  @db.Text // القصة التاريخية
  price           Decimal  @db.Decimal(10, 2)
  compareAtPrice  Decimal? @db.Decimal(10, 2)
  countryOfOrigin String?
  era             String? // الحقبة الزمنية
  material        String? // المادة
  dimensions      String? // الأبعاد
  condition       String? // الحالة
  stock           Int      @default(1)
  isFeatured      Boolean  @default(false)
  isRare          Boolean  @default(false) // قطعة نادرة
  isActive        Boolean  @default(true)
  viewsCount      Int      @default(0)
  videoUrl        String?
  categoryId      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category      Category       @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  auctionItem   AuctionItem?

  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  order     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ---------------- السلة والمفضلة ----------------
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist")
}

// ---------------- الطلبات ----------------
model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String
  addressId   String?
  status      OrderStatus @default(PENDING)
  subtotal    Decimal     @db.Decimal(10, 2)
  shippingFee Decimal     @default(0) @db.Decimal(10, 2)
  taxAmount   Decimal     @default(0) @db.Decimal(10, 2)
  discount    Decimal     @default(0) @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  couponId    String?
  paymentMethod String?
  notes       String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  address Address?    @relation(fields: [addressId], references: [id])
  coupon  Coupon?     @relation(fields: [couponId], references: [id])
  items   OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  title     String
  price     Decimal @db.Decimal(10, 2)
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ---------------- الكوبونات ----------------
model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Decimal    @db.Decimal(10, 2)
  minOrder    Decimal?   @db.Decimal(10, 2)
  usageLimit  Int?
  usedCount   Int        @default(0)
  isActive    Boolean    @default(true)
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())

  orders Order[]

  @@map("coupons")
}

// ---------------- المزادات (تسجيل اهتمام فقط - MVP) ----------------
model AuctionItem {
  id             String   @id @default(cuid())
  productId      String   @unique
  estimatedPrice Decimal  @db.Decimal(10, 2)
  deadline       DateTime // تاريخ انتهاء استقبال الطلبات
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  interests AuctionInterest[]

  @@map("auction_items")
}

model AuctionInterest {
  id            String   @id @default(cuid())
  auctionItemId String
  userId        String?
  name          String
  phone         String
  email         String
  maxBudget     Decimal  @db.Decimal(10, 2)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())

  auctionItem AuctionItem @relation(fields: [auctionItemId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id])

  @@map("auction_interest")
}

// ---------------- الباحث الشخصي ----------------
model PersonalShopperRequest {
  id              String   @id @default(cuid())
  userId          String?
  itemType        String // نوع القطعة
  era             String?
  countryOfOrigin String?
  budget          Decimal? @db.Decimal(10, 2)
  description     String   @db.Text
  referenceImages String?  @db.Text // JSON array من روابط الصور
  status          String   @default("NEW") // NEW / IN_PROGRESS / FULFILLED / CLOSED
  createdAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("personal_shopper_requests")
}

// ---------------- الإشعارات ----------------
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ---------------- الإعدادات (تشمل السكربتات: قيمها مفاتيح مثل script_ga / script_meta_pixel / script_custom_head) ----------------
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  @@map("settings")
}

// ---------------- مكتبة الوسائط (الصور والملفات المرفوعة من لوحة الإدارة) ----------------
model Media {
  id           String   @id @default(cuid())
  url          String
  filename     String // الاسم المخزّن فعليًا على القرص
  originalName String // الاسم الأصلي عند الرفع
  mimeType     String
  size         Int // بالبايت
  altText      String?
  createdAt    DateTime @default(now())

  @@map("media")
}

// ---------------- محتوى الصفحة الرئيسية القابل للتعديل (Hero + البانرات الترويجية) ----------------
model ContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique // hero / promo_auction / promo_shopper
  title     String?
  subtitle  String?  @db.Text
  imageUrl  String?
  linkUrl   String?
  linkText  String?
  updatedAt DateTime @updatedAt

  @@map("content_blocks")
}

// ---------------- آراء العملاء (تُعرض في الصفحة الرئيسية) ----------------
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  text      String   @db.Text
  rating    Int      @default(5)
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("testimonials")
}

// ---------------- شارات الثقة (شحن سريع، دعم عملاء...) ----------------
model TrustBadge {
  id       String  @id @default(cuid())
  icon     String // مفتاح الأيقونة (truck / gift / shield-check / headphones / package-check)
  title    String
  subtitle String?
  order    Int     @default(0)
  isActive Boolean @default(true)

  @@map("trust_badges")
}
